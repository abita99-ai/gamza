# Gamza Supabase 설정 템플릿
# 주의: 실제 키가 포함된 .env 또는 .env.txt 파일은 절대 Git에 커밋하지 마세요.

# Supabase Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (클라이언트 브라우저에서 사용할 수 있는 공개 키)
SUPABASE_ANON_KEY=your-anon-public-key

# [주의] 아래 키들은 프론트엔드 코드나 공개 저장소에 절대 노출되면 안 됩니다.
# Supabase Service Role Secret (백엔드 전용 관리자 키)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Supabase Access Token
# SUPABASE_ACCESS_TOKEN=your-access-token
